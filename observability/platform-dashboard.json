{"uid":"platform-local","title":"Platform: actual business and delivery health","schemaVersion":40,"version":2,"refresh":"10s","time":{"from":"now-30m","to":"now"},"panels":[{"id":1,"title":"Service readiness","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"service_ready","legendFormat":"{{instance}}"}]},{"id":2,"title":"HTTP business requests per second","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by (instance, status) (rate(http_requests_total[2m]))","legendFormat":"{{instance}} {{status}}"}]},{"id":3,"title":"Durable outbox oldest age / pending","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"outbox_oldest_age_seconds","legendFormat":"oldest age seconds"},{"expr":"outbox_pending","legendFormat":"pending"}]},{"id":4,"title":"Delivery states and attempts","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"sum by (status) (delivery_jobs_total)","legendFormat":"jobs {{status}}"},{"expr":"sum by (status) (rate(delivery_attempts_total[2m]))","legendFormat":"attempts {{status}}"}]},{"id":5,"title":"p95 HTTP latency","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,instance) (rate(http_request_duration_seconds_bucket[2m])))","legendFormat":"{{instance}}"}]},{"id":6,"title":"Kafka sampled committed lag (not full broker backlog)","description":"Last fetched high-watermark minus durable committed progress for assigned partitions only. Use authoritative rpk group describe for current full broker lag; interpret together with sample age.","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"expr":"kafka_sampled_committed_lag","legendFormat":"{{instance}} {{topic}} p{{partition}}"}]},{"id":7,"title":"Kafka lag sample age (seconds)","description":"An old timestamp means no recent high-watermark observation, not proof of zero current broker backlog.","type":"timeseries","datasource":{"uid":"prometheus","type":"prometheus"},"gridPos":{"x":0,"y":24,"w":24,"h":8},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"time() - kafka_sampled_committed_lag_timestamp_seconds","legendFormat":"{{instance}} {{topic}} p{{partition}} age"}]}]}
