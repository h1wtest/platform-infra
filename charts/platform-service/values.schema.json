{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "uid": {
      "type": "integer",
      "minimum": 1
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "autoscaling": {
      "type": "boolean"
    },
    "pdb": {
      "type": "boolean"
    },
    "publicService": {
      "type": "boolean"
    },
    "tls": {
      "type": "boolean"
    },
    "readinessPath": {
      "type": "string"
    },
    "livePath": {
      "type": "string"
    },
    "probePort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "credentialRevision": {
      "type": "string"
    },
    "configRevision": {
      "type": "string"
    },
    "cpu": {
      "type": "string",
      "minLength": 1
    },
    "memory": {
      "type": "string",
      "minLength": 1
    },
    "cpuLimit": {
      "type": "string",
      "minLength": 1
    },
    "memoryLimit": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ]
      }
    },
    "servicePorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "port",
          "targetPort"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "targetPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "databaseGate": {
      "type": "boolean"
    },
    "postgresImage": {
      "type": "string",
      "minLength": 1
    },
    "databaseSecret": {
      "type": "string",
      "minLength": 1
    },
    "databaseGateScript": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "image",
    "ports",
    "uid",
    "replicas",
    "autoscaling",
    "tls",
    "readinessPath",
    "livePath",
    "env",
    "volumes",
    "mounts",
    "servicePorts",
    "cpu",
    "memory",
    "cpuLimit",
    "memoryLimit",
    "command",
    "args"
  ]
}
