{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "const": "platform-config"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "port"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "apiNetworkPolicy": {
      "type": "object",
      "required": [
        "spec"
      ],
      "properties": {
        "spec": {
          "type": "object",
          "required": [
            "egress"
          ],
          "properties": {
            "egress": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "to",
                  "ports"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name",
    "secrets",
    "configMaps",
    "applications"
  ]
}
