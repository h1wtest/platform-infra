# Canonical infrastructure credentials; copy names only, never commit real values.
# Bootstrap generates missing credentials once; initialized state fails closed if lost.
# OWNER_EMAIL/OWNER_PASSWORD are identity bootstrap inputs; never infrastructure credentials.
# TELEGRAM_BOT_TOKEN/TELEGRAM_WEBHOOK_SECRET belong to user-notification-service/.env.
PUBLIC_ORIGIN=https://localhost:8448
ENVIRONMENT=local
POSTGRES_PASSWORD=
GATEWAY_TOKEN=
GRAFANA_PASSWORD=
KAFKA_BOOTSTRAP_PASSWORD=
# Private bytes use JSON-compatible double-quoted strings with escaped newlines.
CA_PRIVATE_KEY=
TLS_PRIVATE_KEY=
BACKUP_ENCRYPTION_KEY=
GATEWAY_TLS_PRIVATE_KEY=
REDPANDA_TLS_PRIVATE_KEY=
# Generic profile uses .generic-local/owners/<repository>/.env exclusively.
# Optional NOWPAYMENTS_API_KEY/NOWPAYMENTS_IPN_SECRET belong only to billing-service.
# Generic PostgreSQL private identity belongs only to platform-infra owner env.
# POSTGRES_TLS_PRIVATE_KEY=
