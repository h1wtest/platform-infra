# Project
PROJECT_NAME=sso_platform

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_pass
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=identity_db,user_db,admin_db

# Redis
REDIS_PASSWORD=redis_secret_pass
REDIS_PORT=6379

# Redpanda (Kafka)
KAFKA_BROKER_PORT=9092
REDPANDA_CONSOLE_PORT=8080

# Mailpit (SMTP + Web UI)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Jaeger (Tracing)
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318